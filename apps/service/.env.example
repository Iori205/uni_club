# Postgres connection string (Supabase/Neon/Railway гэх мэт managed provider-оос авна).
DATABASE_URL="postgresql://user:password@host:5432/uniclub?schema=public"

PORT=3000

# local | s3 | supabase — зурган upload storage adapter сонголт (§7 image upload flow).
# Development: local. Production: supabase (Supabase PostgreSQL-тэй ижил project).
STORAGE_DRIVER=local
# STORAGE_DRIVER=local үед ашиглагдана.
UPLOAD_DIR=./uploads

# STORAGE_DRIVER=supabase үед ашиглагдана (Supabase Dashboard -> Project Settings -> API).
# SUPABASE_URL: https://<project-ref>.supabase.co (DATABASE_URL-тэй ижил project-ийн ref).
# SUPABASE_SERVICE_ROLE_KEY: Service Role key (Storage-д server-side бичихэд шаардлагатай, HИЧ ХЭЗЭЭ client рүү дамжуулахгүй/commit хийхгүй).
# SUPABASE_STORAGE_BUCKET: Supabase Dashboard -> Storage дээр урьдчилан үүсгэсэн, Public гэж тохируулсан bucket-ийн нэр.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# CORS-д зөвшөөрөх frontend origin-ууд.
WEB_ORIGIN=http://localhost:3001
DASH_ORIGIN=http://localhost:3002

# /admin/* route-уудыг хамгаалахад ашиглана (apps/dash-тай ижил Clerk application-ий Secret Key).
CLERK_SECRET_KEY=
