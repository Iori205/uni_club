{
  "name": "uni_club",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "dash": "yarn workspace dash dev",
    "service": "yarn workspace service dev",
    "web": "yarn workspace web dev"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.8",
    "typescript": "5.9.2",
    "vercel": "^59.5.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "yarn",
      "version": "1.22.22"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
